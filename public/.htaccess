# =============================================================================
# Julie Guzal — Apache config for the statically generated site (OVH shared
# hosting). `nuxi generate` copies this file to `.output/public/.htaccess`.
#
# Nitro `routeRules` (headers, redirects, cache…) are NOT applied in
# production: there is no Nitro server. Everything HTTP lives here.
#
# Sections:
#   1. Redirects (canonical host, HTTPS, legacy URLs)
#   2. Clean URLs & error page
#   3. Precompressed assets (.br / .gz) + mod_deflate fallback
#   4. MIME types
#   5. Security headers (HSTS, CSP report-only, …)
#   6. Cache
# =============================================================================

RewriteEngine On

# -----------------------------------------------------------------------------
# 1. Redirects (all 301)
# -----------------------------------------------------------------------------

# 1.1 Secondary domains and www → https://julieguzal.fr
#     Only these hosts are matched, so localhost / staging are left untouched.
RewriteCond %{HTTP_HOST} ^(www\.)?julie-guzal\.(com|fr)(:[0-9]+)?$ [NC,OR]
RewriteCond %{HTTP_HOST} ^(www\.)?julieguzal\.com(:[0-9]+)?$ [NC,OR]
RewriteCond %{HTTP_HOST} ^www\.julieguzal\.fr(:[0-9]+)?$ [NC]
RewriteRule ^(.*)$ https://julieguzal.fr/$1 [R=301,L]

# 1.2 http → https on the production domain only.
#     OVH terminates TLS on its load balancer: check both the port seen by
#     Apache and X-Forwarded-Proto to avoid a redirect loop.
RewriteCond %{HTTP_HOST} ^julieguzal\.fr(:[0-9]+)?$ [NC]
RewriteCond %{HTTPS} !=on
RewriteCond %{SERVER_PORT} ^80$
RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC,NV]
RewriteRule ^(.*)$ https://julieguzal.fr/$1 [R=301,L]

# 1.3 Legacy URLs (mirror of `nitro.routeRules` redirects, which only emit
#     meta-refresh pages when generated). Matches `/x`, `/x/`, `/x.html`
#     and `/x/index.html`.
RewriteRule ^(home|accueil|en)(/|\.html|/index\.html)?$ / [R=301,L]
RewriteRule ^(en/)?about(/|\.html|/index\.html)?$ /contact [R=301,L]
RewriteRule ^projects/arturia(/|\.html|/index\.html)?$ / [R=301,L]

# -----------------------------------------------------------------------------
# 2. Clean URLs & error page
# -----------------------------------------------------------------------------

# Never serve .htaccess (nor its precompressed copies emitted by Nitro).
RewriteRule (^|/)\.ht - [F,L]

# Serve `/contact` from `contact/index.html` directly, instead of letting
# mod_dir answer with a 301 to `http(s)://julieguzal.fr:443/contact/` (Nuxt
# links have no trailing slash). DirectorySlash must be off, otherwise mod_dir
# still redirects after the rewrite. No directory listing either way.
<IfModule mod_dir.c>
    DirectorySlash Off
</IfModule>
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+[^/])$ $1/index.html [L]

# 404 page generated by Nuxt
ErrorDocument 404 /404.html

# -----------------------------------------------------------------------------
# 3. Compression
# -----------------------------------------------------------------------------

# 3.1 Precompressed files: `nitro.compressPublicAssets` emits `file.br` and
#     `file.gz` next to each asset. Serve them when the client accepts it.
RewriteCond %{HTTP:Accept-Encoding} \bbr\b
RewriteCond %{REQUEST_FILENAME}.br -f
RewriteRule ^(.+)$ $1.br [L]

RewriteCond %{HTTP:Accept-Encoding} \bgzip\b
RewriteCond %{REQUEST_FILENAME}.gz -f
RewriteRule ^(.+)$ $1.gz [L]

# Restore the original Content-Type and disable on-the-fly compression.
RewriteRule \.html\.(br|gz)$ - [T=text/html;charset=utf-8,E=no-gzip:1,E=no-brotli:1]
RewriteRule \.css\.(br|gz)$ - [T=text/css;charset=utf-8,E=no-gzip:1,E=no-brotli:1]
RewriteRule \.js\.(br|gz)$ - [T=text/javascript;charset=utf-8,E=no-gzip:1,E=no-brotli:1]
RewriteRule \.json\.(br|gz)$ - [T=application/json;charset=utf-8,E=no-gzip:1,E=no-brotli:1]
RewriteRule \.svg\.(br|gz)$ - [T=image/svg+xml,E=no-gzip:1,E=no-brotli:1]
RewriteRule \.(xml|xsl)\.(br|gz)$ - [T=application/xml,E=no-gzip:1,E=no-brotli:1]
RewriteRule \.ttf\.(br|gz)$ - [T=font/ttf,E=no-gzip:1,E=no-brotli:1]
RewriteRule \.txt\.(br|gz)$ - [T=text/plain;charset=utf-8,E=no-gzip:1,E=no-brotli:1]

<IfModule mod_mime.c>
    # `.br` / `.gz` must not be treated as types or encodings by mod_mime:
    # the encoding is set explicitly below.
    RemoveType .br .gz
    RemoveEncoding .br .gz
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.br$">
        Header set Content-Encoding br
        Header append Vary Accept-Encoding
    </FilesMatch>
    <FilesMatch "\.gz$">
        Header set Content-Encoding gzip
        Header append Vary Accept-Encoding
    </FilesMatch>
</IfModule>

# 3.2 Fallback: on-the-fly gzip for text files without a precompressed copy.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml text/javascript application/javascript application/json application/manifest+json application/xml image/svg+xml
</IfModule>

# -----------------------------------------------------------------------------
# 4. MIME types
# -----------------------------------------------------------------------------

<IfModule mod_mime.c>
    AddType text/javascript .js .mjs
    AddType application/manifest+json .webmanifest
    AddType font/woff2 .woff2
    AddType font/woff .woff
    AddType font/ttf .ttf
    AddType video/webm .webm
    AddType video/mp4 .mp4
    AddCharset utf-8 .html .css .js .json .svg .xml .webmanifest .txt
</IfModule>

# -----------------------------------------------------------------------------
# 5. Security headers
# -----------------------------------------------------------------------------

<IfModule mod_headers.c>
    # HSTS, only on responses served over HTTPS
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on' || %{SERVER_PORT} == '443' || req_novary('X-Forwarded-Proto') == 'https'"

    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=(), browsing-topics=()"

    # Framing: same origin + Prismic (Page Builder / preview frames the site).
    # X-Frame-Options for old browsers; modern browsers ignore it when an
    # enforced CSP `frame-ancestors` is present, hence this dedicated,
    # enforced policy (the full policy below is still report-only).
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Content-Security-Policy "frame-ancestors 'self' https://*.prismic.io"

    # Content Security Policy — REPORT-ONLY: violations are logged in the
    # browser console but nothing is blocked. Switch the header name to
    # `Content-Security-Policy` (merged with the frame-ancestors one above)
    # once production shows no violation.
    #  - script-src 'unsafe-inline': Nuxt inlines an import map and
    #    `window.__NUXT__` config whose content (thus hash) changes each build.
    #    static.cdn.prismic.io = Prismic toolbar (non-production builds).
    #  - style-src 'unsafe-inline': Vue `style` bindings (CSS variables).
    #  - img/media: Prismic image CDN (imgix), Prismic media CDN, Vimeo thumbnails.
    #  - connect-src: Prismic API (client-side navigation, previews).
    #  - frame-src: embeds allowed in Prismic content.
    Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cdn.prismic.io; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://images.prismic.io https://*.cdn.prismic.io https://i.vimeocdn.com; media-src 'self' blob: https://images.prismic.io https://*.cdn.prismic.io; font-src 'self'; connect-src 'self' https://*.prismic.io; frame-src 'self' https://*.prismic.io https://*.youtube-nocookie.com https://*.youtube.com https://*.vimeo.com https://*.instagram.com https://*.soundcloud.com https://*.google.com https://*.deezer.com https://*.spotify.com; frame-ancestors 'self' https://*.prismic.io; object-src 'none'; base-uri 'self'; form-action 'self'"
</IfModule>

# -----------------------------------------------------------------------------
# 6. Cache
# -----------------------------------------------------------------------------

<IfModule mod_headers.c>
    # HTML, payloads, sitemap, robots: always revalidate (new deploys are
    # visible immediately).
    <FilesMatch "\.(html|json|xml|xsl|txt)(\.br|\.gz)?$">
        Header set Cache-Control "no-cache"
    </FilesMatch>

    # Favicons, manifest, share image: 1 day
    <FilesMatch "\.(ico|png|svg|jpg|webmanifest)(\.br|\.gz)?$">
        Header set Cache-Control "public, max-age=86400"
    </FilesMatch>

    # Splash video: 10 minutes
    <FilesMatch "^splash\.(webm|mp4)$">
        Header set Cache-Control "public, max-age=600, must-revalidate"
    </FilesMatch>

    # Hashed build assets (JS, CSS, fonts, images, i18n messages): 1 year.
    # <If> sections are merged after <FilesMatch>, so this wins.
    <If "%{REQUEST_URI} =~ m#^/(_nuxt|_i18n)/#">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    <FilesMatch "^splash\.(webm|mp4)$">
        ExpiresDefault "access plus 10 minutes"
    </FilesMatch>
</IfModule>
