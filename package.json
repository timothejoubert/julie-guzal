{
    "version": "1.0.10",
    "name": "timothejoubert/julie-guzal",
    "description": "Julie guzal personal website",
    "author": "Timothé Joubert",
    "engines": {
        "node": "24.19.0"
    },
    "scripts": {
        "dev": "nuxi dev",
        "build": "nuxi build",
        "analyze": "nuxi analyze",
        "generate": "nuxi generate",
        "generate:prod": "nuxi generate --dotenv .env.prod",
        "preview": "nuxi preview",
        "prepare": "nuxi prepare && husky .husky",
        "postinstall": "nuxi prepare",
        "lint": "pnpm lint:js && pnpm lint:css",
        "lint-fix": "pnpm lint:js --fix && pnpm lint:css --fix",
        "lint:js": "eslint .",
        "lint:css": "stylelint \"**/*.{vue,css,scss}\"",
        "typecheck": "nuxi typecheck",
        "type-gen": "npx prismic gen types"
    },
    "devDependencies": {
        "@nuxt/eslint": "^1.17.0",
        "@nuxt/image": "2.1.0",
        "@nuxtjs/i18n": "^10.6.0",
        "@nuxtjs/prismic": "^5.3.1",
        "@nuxtjs/robots": "6.2.4",
        "@nuxtjs/sitemap": "8.6.0",
        "@nuxtjs/svg-sprite": "^1.0.2",
        "@prismicio/client": "^7.22.1",
        "@prismicio/vue": "^6.1.5",
        "@types/lodash": "^4.17.25",
        "@vueuse/core": "^15.0.0",
        "@vueuse/nuxt": "^15.0.0",
        "eslint": "^10.11.0",
        "husky": "^9.1.7",
        "include-media": "^2.0.0",
        "nuxt": "4.5.2",
        "postcss-html": "^2.0.0",
        "prettier": "^3.9.9",
        "sass": "1.105.0",
        "stylelint": "^17.15.0",
        "stylelint-config-css-modules": "^4.6.0",
        "stylelint-config-html": "^2.0.0",
        "stylelint-config-idiomatic-order": "^10.0.0",
        "stylelint-config-recommended-vue": "^2.0.0",
        "stylelint-config-standard-scss": "^17.0.0",
        "stylelint-config-standard-vue": "^2.0.0",
        "stylelint-order": "^8.1.1",
        "typescript": "^5.9.3",
        "vite-svg-loader": "^5.1.3",
        "vue-tsc": "^3.3.11"
    },
    "dependencies": {
        "@netlify/functions": "^6.0.0",
        "gsap": "^3.15.0",
        "lenis": "^1.3.26",
        "lodash": "^4.18.1",
        "plyr": "^3.8.4",
        "tiny-emitter": "^2.1.0",
        "ufo": "^1.6.4"
