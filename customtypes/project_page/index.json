{
  "format": "page",
  "id": "project_page",
  "json": {
    "Main": {
      "uid": {
        "config": {
          "label": "URL",
          "placeholder": "Ne plus changer après publication"
        },
        "type": "UID"
      },
      "back_button_theme": {
        "config": {
          "default_value": "light",
          "label": "Bouton retour",
          "options": [
            "light",
            "dark"
          ],
          "placeholder": "Selon le fond de la 1re image"
        },
        "type": "Select"
      },
      "title": {
        "config": {
          "label": "Titre",
          "placeholder": ""
        },
        "type": "Text"
      },
      "content": {
        "config": {
          "allowTargetBlank": true,
          "label": "Introduction",
          "multi": "paragraph,preformatted,heading1,heading2,heading3,heading4,heading5,heading6,strong,em,hyperlink,image,embed,list-item,o-list-item,rtl",
          "placeholder": ""
        },
        "type": "StructuredText"
      },
      "image": {
        "config": {
          "constraint": {},
          "label": "Image de couverture",
          "thumbnails": []
        },
        "type": "Image"
      },
      "archived": {
        "config": {
          "default_value": false,
          "label": "Archivé",
          "placeholder_false": "Visible",
          "placeholder_true": "Masqué du site, lien direct actif"
        },
        "type": "Boolean"
      },
      "order_date": {
        "config": {
          "label": "Date de tri",
          "placeholder": "Tri de l'accueil, le plus récent en premier"
        },
        "type": "Date"
      },
      "creation_date": {
        "config": {
          "label": "Date du projet",
          "placeholder": "Année affichée"
        },
        "type": "Date"
      },
      "credits": {
        "config": {
          "allowTargetBlank": true,
          "label": "Crédits",
          "multi": "paragraph,strong,em,hyperlink",
          "placeholder": ""
        },
        "type": "StructuredText"
      },
      "external_url": {
        "config": {
          "label": "Lien externe",
          "placeholder": "https://…"
        },
        "type": "Text"
      },
      "external_url_label": {
        "config": {
          "label": "Texte du lien",
          "placeholder": "ex. Voir le site"
        },
        "type": "Text"
      },
      "slices": {
        "config": {
          "choices": {
            "simple_content": {
              "type": "SharedSlice"
            },
            "media": {
              "type": "SharedSlice"
            },
            "cross_nav": {
              "type": "SharedSlice"
            }
          }
        },
        "fieldset": "Slice Zone",
        "type": "Slices"
      }
    },
    "SEO & Metadata": {
      "meta_title": {
        "config": {
          "label": "Titre SEO",
          "placeholder": "Titre pour Google"
        },
        "type": "Text"
      },
      "meta_description": {
        "config": {
          "label": "Description SEO",
          "placeholder": "≈ 155 caractères"
        },
        "type": "Text"
      },
      "meta_image": {
        "config": {
          "constraint": {
            "height": 1260,
            "width": 2400
          },
          "label": "Image de partage",
          "thumbnails": []
        },
        "type": "Image"
      }
    }
  },
  "label": "Projet",
  "repeatable": true,
  "status": true
}